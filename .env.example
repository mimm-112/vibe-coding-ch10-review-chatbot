# ============================================================
# 챕터 10 쇼핑 리뷰 분석 챗봇 : 환경 변수
# 이 파일을 .env 로 복사한 뒤 값을 채우세요.
#   cp .env.example .env
#
# 💰 비용 안내
#   Pinecone(Starter) · Pinecone 임베딩 · 수파베이스 = 전부 무료
#   돈이 드는 건 "답변 생성 LLM" 하나뿐이라, 무료 옵션을 기본값으로 두었습니다.
# ============================================================

# --- 답변 생성 LLM 선택 -------------------------------------
# gemini (기본) : 구글 AI 스튜디오 무료 API 키. 카드 등록 불필요.
# ollama        : 내 컴퓨터에서 모델 실행. 완전 무료 + 오프라인.
# openai        : 교재와 동일. 최소 $5 크레딧 충전 필요.
LLM_PROVIDER=gemini

# [gemini] https://aistudio.google.com/apikey 에서 무료 발급
GOOGLE_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-2.5-flash

# [ollama] 터미널에서 먼저 준비하세요
#   brew install ollama && ollama serve
#   ollama pull llama3.2
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# [openai] 교재대로 진행할 때만 필요합니다
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5-nano

# --- Pinecone (벡터 데이터베이스) — 무료 --------------------
# pinecone.io 가입 후 [API keys]에서 발급
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxx
# 인덱스 상세 화면의 HOST 값 (선택. 없으면 이름으로 자동 조회)
# PINECONE_HOST=https://review-chatbot-xxxxxx.svc.aped-4627-b74a.pinecone.io
PINECONE_INDEX=review-chatbot

# --- Supabase (대화 기록 · 리뷰 원본 저장) — 무료 -----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_xxxxxxxxxxxx
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
